# ===========================================
# HEALTHBRIDGE - Environment Configuration
# Copy this file to .env and fill in values
# ===========================================

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=5000
NODE_ENV=development

# ===========================================
# DATABASE - MongoDB Atlas or Local
# ===========================================
MONGODB_URI=mongodb://localhost:27017/healthbridge

# ===========================================
# AUTHENTICATION (JWT)
# ===========================================
JWT_SECRET=your_jwt_secret_at_least_64_characters_long
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ===========================================
# EMAIL - SMTP
# ===========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=HealthBridge <your_email@gmail.com>

# ===========================================
# CLOUDINARY - File Uploads
# ===========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===========================================
# TWILIO - SMS (Optional)
# ===========================================
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=your_phone_number
ENABLE_SMS=false

# ===========================================
# REDIS - Caching (Production)
# ===========================================
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# ===========================================
# CLIENT URL (Update for production)
# ===========================================
CLIENT_URL=http://localhost:5173

# ===========================================
# FEATURE FLAGS
# ===========================================
LOG_OTP_TO_CONSOLE=true

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_MS=900000

# ===========================================
# OTP SETTINGS
# ===========================================
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=30

# ===========================================
# LOGIN SECURITY
# ===========================================
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30

# ===========================================
# PROVIDER SETTINGS
# ===========================================
DEFAULT_SEARCH_RADIUS_KM=10
MAX_SEARCH_RADIUS_KM=20

# ===========================================
# FILE UPLOAD
# ===========================================
MAX_FILE_SIZE_MB=5

# ===========================================
# GOOGLE OAUTH (Optional)
# ===========================================
GOOGLE_CLIENT_ID=your_google_client_id

# ===========================================
# CONTACT INFO
# ===========================================
TELEGRAM_CONTACT_URL=https://t.me/your_telegram
SUPPORT_EMAIL=support@yourdomain.com
SUPPORT_PHONE=+91-XXXXXXXXXX

# ===========================================
# INVOICE
# ===========================================
INVOICE_COMPANY_NAME=HealthBridge Healthcare Services
INVOICE_COMPANY_ADDRESS=Your Address
INVOICE_COMPANY_GST=
INVOICE_PREFIX=HB
